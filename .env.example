# Required
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low        # leave empty for non-reasoning models (e.g. qwen/qwen3.8-27b)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_flash_v2_5
# DEEPGRAM_MODEL=nova-2
# INTERVIEW_DURATION_MINUTES=10
# SILENCE_THRESHOLD_SECONDS=1.2
# BARGE_IN_MIN_WORDS=2
# INTERVIEW_LINK_TTL_MINUTES=30  # unstarted interviews expire after this
# MAX_RESUME_MB=5

# Database (SQLite file by default; any SQLAlchemy async URL works, e.g. postgresql+asyncpg://...)
# DATABASE_URL=sqlite+aiosqlite:///./data/interview_bot.db

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=text                 # "json" for one JSON object per line
